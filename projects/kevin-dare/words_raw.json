: 220.66, "e": 221.5}, {"w": " Samoah", "s": 221.5, "e": 221.98}, {"w": " Feeley", "s": 221.98, "e": 222.26}]}, {"start": 222.26, "end": 222.86, "text": "in Kansas.", "words": [{"w": " in", "s": 222.26, "e": 222.44}, {"w": " Kansas.", "s": 222.44, "e": 222.86}]}, {"start": 223.56, "end": 226.6, "text": "By then about 20 vaulters had died since 1980.", "words": [{"w": " By", "s": 223.56, "e": 223.7}, {"w": " then", "s": 223.7, "e": 224.0}, {"w": " about", "s": 224.0, "e": 224.28}, {"w": " 20", "s": 224.28, "e": 224.76}, {"w": " vaulters", "s": 224.76, "e": 225.24}, {"w": " had", "s": 225.24, "e": 225.42}, {"w": " died", "s": 225.42, "e": 225.66}, {"w": " since", "s": 225.66, "e": 225.88}, {"w": " 1980.", "s": 225.88, "e": 226.6}]}, {"start": 227.38, "end": 230.6, "text": "And Kevin Dad Ed said something that I can't get out my head.", "words": [{"w": " And", "s": 227.38, "e": 227.54}, {"w": " Kevin", "s": 227.54, "e": 227.76}, {"w": " Dad", "s": 227.76, "e": 228.0}, {"w": " Ed", "s": 228.0, "e": 228.3}, {"w": " said", "s": 228.3, "e": 228.52}, {"w": " something", "s": 228.52, "e": 228.94}, {"w": " that", "s": 228.94, "e": 229.18}, {"w": " I", "s": 229.18, "e": 229.46}, {"w": " can't", "s": 229.46, "e": 229.82}, {"w": " get", "s": 229.82, "e": 229.94}, {"w": " out", "s": 229.94, "e": 230.12}, {"w": " my", "s": 230.12, "e": 230.28}, {"w": " head.", "s": 230.28, "e": 230.6}]}, {"start": 231.3, "end": 236.24, "text": "He said, had I known what I know right now, Kevin would not be jumping.", "words": [{"w": " He", "s": 231.3, "e": 231.52}, {"w": " said,", "s": 231.52, "e": 231.86}, {"w": " had", "s": 232.52, "e": 232.62}, {"w": " I", "s": 232.62, "e": 232.78}, {"w": " known", "s": 232.78, "e": 233.02}, {"w": " what", "s": 233.02, "e": 233.2}, {"w": " I", "s": 233.2, "e": 233.3}, {"w": " know", "s": 233.3, "e": 233.56}, {"w": " right", "s": 233.56, "e": 233.78}, {"w": " now,", "s": 233.78, "e": 234.44}, {"w": " Kevin", "s": 234.8, "e": 235.12}, {"w": " would", "s": 235.12, "e": 235.32}, {"w": " not", "s": 235.32, "e": 235.64}, {"w": " be", "s": 235.64, "e": 235.92}, {"w": " jumping.", "s": 235.92, "e": 236.24}]}, {"start": 237.38, "end": 239.4, "text": "But Ed and Terry didn't just grieve.", "words": [{"w": " But", "s": 237.38, "e": 237.58}, {"w": " Ed", "s": 237.58, "e": 237.88}, {"w": " and", "s": 237.88, "e": 238.12}, {"w": " Terry", "s": 238.12, "e": 238.38}, {"w": " didn't", "s": 238.38, "e": 238.76}, {"w": " just", "s": 238.76, "e": 238.96}, {"w": " grieve.", "s": 238.96, "e": 239.4}]}, {"start": 240.1, "end": 240.96, "text": "They went to work.", "words": [{"w": " They", "s": 240.1, "e": 240.34}, {"w": " went", "s": 240.34, "e": 240.48}, {"w": " to", "s": 240.48, "e": 240.68}, {"w": " work.", "s": 240.68, "e": 240.96}]}, {"start": 240.96, "end": 246.52, "text": "A couple months later, Ed and Tim Curley brought coaches and safety experts to State College", "words": [{"w": " A", "s": 240.96, "e": 241.86}, {"w": " couple", "s": 241.86, "e": 242.1}, {"w": " months", "s": 242.1, "e": 242.36}, {"w": " later,", "s": 242.36, "e": 242.76}, {"w": " Ed", "s": 243.08, "e": 243.22}, {"w": " and", "s": 243.22, "e": 243.36}, {"w": " Tim", "s": 243.36, "e": 243.64}, {"w": " Curley", "s": 243.64, "e": 243.96}, {"w": " brought", "s": 243.96, "e": 244.22}, {"w": " coaches", "s": 244.22, "e": 244.66}, {"w": " and", "s": 244.66, "e": 244.92}, {"w": " safety", "s": 244.92, "e": 245.26}, {"w": " experts", "s": 245.26, "e": 245.66}, {"w": " to", "s": 245.66, "e": 245.94}, {"w": " State", "s": 245.94, "e": 246.18}, {"w": " College", "s": 246.18, "e": 246.52}]}, {"start": 246.52, "end": 248.9, "text": "to figure out how to make the pole vault safer.", "words": [{"w": " to", "s": 246.52, "e": 246.76}, {"w": " figure", "s": 246.76, "e": 247.0}, {"w": " out", "s": 247.0, "e": 247.26}, {"w": " how", "s": 247.26, "e": 247.48}, {"w": " to", "s": 247.48, "e": 247.64}, {"w": " make", "s": 247.64, "e": 247.8}, {"w": " the", "s": 247.8, "e": 248.0}, {"w": " pole", "s": 248.0, "e": 248.2}, {"w": " vault", "s": 248.2, "e": 248.4}, {"w": " safer.", "s": 248.4, "e": 248.9}]}, {"start": 249.68, "end": 254.2, "text": "That August, the Big Ten made the landing pads longer and made padded collars around", "words": [{"w": " That", "s": 249.68, "e": 249.84}, {"w": " August,", "s": 249.84, "e": 250.24}, {"w": " the", "s": 250.66, "e": 250.72}, {"w": " Big", "s": 250.72, "e": 250.88}, {"w": " Ten", "s": 250.88, "e": 251.1}, {"w": " made", "s": 251.1, "e": 251.36}, {"w": " the", "s": 251.36, "e": 251.54}, {"w": " landing", "s": 251.54, "e": 251.8}, {"w": " pads", "s": 251.8, "e": 252.08}, {"w": " longer", "s": 252.08, "e": 252.58}, {"w": " and", "s": 252.58, "e": 252.9}, {"w": " made", "s": 252.9, "e": 253.12}, {"w": " padded", "s": 253.12, "e": 253.46}, {"w": " collars", "s": 253.46, "e": 253.9}, {"w": " around", "s": 253.9, "e": 254.2}]}, {"start": 254.2, "end": 255.28, "text": "the box mandatory.", "words": [{"w": " the", "s": 254.2, "e": 254.36}, {"w": " box", "s": 254.36, "e": 254.58}, {"w": " mandatory.", "s": 254.58, "e": 255.28}]}, {"start": 256.0, "end": 257.86, "text": "High school rules made the pits deeper.", "words": [{"w": " High", "s": 256.0, "e": 256.18}, {"w": " school", "s": 256.18, "e": 256.42}, {"w": " rules", "s": 256.42, "e": 256.8}, {"w": " made", "s": 256.8, "e": 257.02}, {"w": " the", "s": 257.02, "e": 257.2}, {"w": " pits", "s": 257.2, "e": 257.4}, {"w": " deeper.", "s": 257.4, "e": 257.86}]}, {"start": 258.5, "end": 262.54, "text": "A company came out with a softbox that took away about two-thirds of the impact,", "words": [{"w": " A", "s": 258.5, "e": 258.7}, {"w": " company", "s": 258.7, "e": 258.98}, {"w": " came", "s": 258.98, "e": 259.24}, {"w": " out", "s": 259.24, "e": 259.44}, {"w": " with", "s": 259.44, "e": 259.56}, {"w": " a", "s": 259.56, "e": 259.74}, {"w": " softbox", "s": 259.74, "e": 260.24}, {"w": " that", "s": 260.24, "e": 260.5}, {"w": " took", "s": 260.5, "e": 260.66}, {"w": " away", "s": 260.66, "e": 260.92}, {"w": " about", "s": 260.92, "e": 261.2}, {"w": " two", "s": 261.2, "e": 261.52}, {"w": "-thirds", "s": 261.52, "e": 261.74}, {"w": " of", "s": 261.74, "e": 261.98}, {"w": " the", "s": 261.98, "e": 262.12}, {"w": " impact,", "s": 262.12, "e": 262.54}]}, {"start": 263.04, "end": 265.72, "text": "and Ed worked on a helmet made just for vaulters.", "words": [{"w": " and", "s": 263.04, "e": 263.28}, {"w": " Ed", "s": 263.28, "e": 263.56}, {"w": " worked", "s": 263.56, "e": 263.82}, {"w": " on", "s": 263.82, "e": 263.96}, {"w": " a", "s": 263.96, "e": 264.16}, {"w": " helmet", "s": 264.16, "e": 264.38}, {"w": " made", "s": 264.38, "e": 264.7}, {"w": " just", "s": 264.7, "e": 265.02}, {"w": " for", "s": 265.02, "e": 265.3}, {"w": " vaulters.", "s": 265.3, "e": 265.72}]}, {"start": 266.52, "end": 270.06, "text": "Now to be fair, not everybody agreed on why it happened.", "words": [{"w": " Now", "s": 266.52, "e": 266.72}, {"w": " to", "s": 266.72, "e": 266.92}, {"w": " be", "s": 266.92, "e": 267.14}, {"w": " fair,", "s": 267.14, "e": 267.48}, {"w": " not", "s": 267.86, "e": 268.02}, {"w": " everybody", "s": 268.02, "e": 268.54}, {"w": " agreed", "s": 268.54, "e": 268.98}, {"w": " on", "s": 268.98, "e": 269.22}, {"w": " why", "s": 269.22, "e": 269.46}, {"w": " it", "s": 269.46, "e": 269.66}, {"w": " happened.", "s": 269.66, "e": 270.06}]}, {"start": 270.06, "end": 275.34, "text": "The head of USA track and field pole vault safety said he didn't know if Kevin Accident", "words": [{"w": " The", "s": 270.06, "e": 271.02}, {"w": " head", "s": 271.02, "e": 271.2}, {"w": " of", "s": 271.2, "e": 271.38}, {"w": " USA", "s": 271.38, "e": 271.78}, {"w": " track", "s": 271.78, "e": 272.08}, {"w": " and", "s": 272.08, "e": 272.26}, {"w": " field", "s": 272.26, "e": 272.52}, {"w": " pole", "s": 272.52, "e": 272.8}, {"w": " vault", "s": 272.8, "e": 273.04}, {"w": " safety", "s": 273.04, "e": 273.44}, {"w": " said", "s": 273.44, "e": 273.74}, {"w": " he", "s": 273.74,